<Page
    x:Class="HandwritingCalculatorUwp.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Padding="16" RowSpacing="12" ColumnSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Handwriting Calculator" FontSize="28" FontWeight="SemiBold" />

        <TextBox x:Name="DisplayBox"
                 Grid.Row="1"
                 IsReadOnly="True"
                 FontSize="34"
                 HorizontalContentAlignment="Right"
                 Text="0" />

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Spacing="8">
                <Grid RowSpacing="8" ColumnSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="MC" Click="MemoryClearClick" />
                    <Button Grid.Row="0" Grid.Column="1" Content="MR" Click="MemoryRecallClick" />
                    <Button Grid.Row="0" Grid.Column="2" Content="M+" Click="MemoryAddClick" />
                    <Button Grid.Row="0" Grid.Column="3" Content="M-" Click="MemorySubtractClick" />

                    <Button Grid.Row="1" Grid.Column="0" Content="C" Click="ClearClick" />
                    <Button Grid.Row="1" Grid.Column="1" Content="⌫" Click="BackspaceClick" />
                    <Button Grid.Row="1" Grid.Column="2" Content="(" Click="OperatorClick" />
                    <Button Grid.Row="1" Grid.Column="3" Content=")" Click="OperatorClick" />

                    <Button Grid.Row="2" Grid.Column="0" Content="7" Click="DigitClick" />
                    <Button Grid.Row="2" Grid.Column="1" Content="8" Click="DigitClick" />
                    <Button Grid.Row="2" Grid.Column="2" Content="9" Click="DigitClick" />
                    <Button Grid.Row="2" Grid.Column="3" Content="÷" Click="OperatorClick" />

                    <Button Grid.Row="3" Grid.Column="0" Content="4" Click="DigitClick" />
                    <Button Grid.Row="3" Grid.Column="1" Content="5" Click="DigitClick" />
                    <Button Grid.Row="3" Grid.Column="2" Content="6" Click="DigitClick" />
                    <Button Grid.Row="3" Grid.Column="3" Content="×" Click="OperatorClick" />

                    <Button Grid.Row="4" Grid.Column="0" Content="1" Click="DigitClick" />
                    <Button Grid.Row="4" Grid.Column="1" Content="2" Click="DigitClick" />
                    <Button Grid.Row="4" Grid.Column="2" Content="3" Click="DigitClick" />
                    <Button Grid.Row="4" Grid.Column="3" Content="-" Click="OperatorClick" />

                    <Button Grid.Row="5" Grid.Column="0" Content="0" Click="DigitClick" />
                    <Button Grid.Row="5" Grid.Column="1" Content="." Click="DecimalClick" />
                    <Button Grid.Row="5" Grid.Column="2" Content="=" Click="EqualsClick" />
                    <Button Grid.Row="5" Grid.Column="3" Content="+" Click="OperatorClick" />
                </Grid>

                <Border BorderBrush="Gray" BorderThickness="1" Padding="8">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Handwriting mode" FontWeight="SemiBold" />
                        <InkCanvas x:Name="InkPad" Height="170" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Recognize &amp; Calculate" Click="RecognizeAndCalculateClick" />
                            <Button Content="Clear Ink" Click="ClearInkClick" />
                        </StackPanel>
                        <TextBlock x:Name="RecognizedTextBlock" Text="Write a math expression above." TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <Border Grid.Column="1" BorderBrush="Gray" BorderThickness="1" Padding="8">
                <StackPanel>
                    <TextBlock Text="History" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListView x:Name="HistoryList" Height="480" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
